# OpenClicky environment variables.
# Copy to `.env` (root) for the agent, and to `backend/.dev.vars` for the backend.
# The backend reads `backend/.dev.vars` (wrangler convention) and falls back to `../.env`.
# NEVER put provider keys in the agent's environment: the agent only talks to the backend.

# ---------------------------------------------------------------------------
# Supabase (your own project — https://supabase.com/dashboard)
# ---------------------------------------------------------------------------
# [backend, agent `token` helper] Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# [agent `token` helper only] Public anon key, used for the email/password sign-in call.
SUPABASE_ANON_KEY=
# [backend] Legacy JWT secret (Settings -> API -> JWT Secret). Used to verify user JWTs with HS256.
# If empty, the backend verifies asymmetric JWTs via SUPABASE_URL/auth/v1/.well-known/jwks.json instead.
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------------
# Model providers (backend only — keys stay server-side)
# ---------------------------------------------------------------------------
# [backend] OpenAI key. Used for /v1/chat/completions (ask lane) and /v1/responses (Codex agent lane).
OPENAI_API_KEY=
# [backend] Optional OpenAI-compatible base URL (default https://api.openai.com/v1).
OPENAI_BASE_URL=
# [backend] Model used when the caller sends no model or model="default" (the `ask` lane).
# Codex sends its own model from config/codex-config.toml; that is passed through unchanged.
OPENAI_MODEL=gpt-5.5
# [backend] Realtime voice model minted by POST /agent/realtime/session (default gpt-realtime).
OPENAI_REALTIME_MODEL=gpt-realtime
# [backend] Speech-to-text model for POST /agent/transcribe (default gpt-4o-mini-transcribe).
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# [backend] Model used by POST /skills/create to draft a SKILL.md (default: OPENAI_MODEL).
SKILL_CREATE_MODEL=
# [backend] Anthropic key for /v1/messages — the cheap "gate" lane used by `openclicky do` / `voice`.
ANTHROPIC_API_KEY=
# [backend] Optional Anthropic base URL (default https://api.anthropic.com).
ANTHROPIC_BASE_URL=
# [backend] Model used when the caller sends model="default" to /v1/messages (the gate).
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# [backend] Model-name mapping for aggregators such as OpenRouter: "from=to,from=to" renames, and a
# prefix added to names without a "/" (the app sends claude-sonnet-4-6; Codex sends gpt-5.6-sol).
MODEL_ALIASES=
OPENAI_MODEL_PREFIX=
ANTHROPIC_MODEL_PREFIX=

# ---------------------------------------------------------------------------
# One-key setup with OpenRouter (text lanes + transcription; no TTS/Realtime there)
# ---------------------------------------------------------------------------
#   OPENAI_API_KEY=sk-or-...            OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   ANTHROPIC_API_KEY=sk-or-...         ANTHROPIC_BASE_URL=https://openrouter.ai/api
#   OPENAI_MODEL=openai/gpt-5.5         ANTHROPIC_MODEL=anthropic/claude-haiku-4.5
#   OPENAI_TRANSCRIBE_MODEL=openai/gpt-4o-mini-transcribe
#   OPENAI_MODEL_PREFIX=openai/         ANTHROPIC_MODEL_PREFIX=anthropic/
#   MODEL_ALIASES=claude-sonnet-4-6=anthropic/claude-sonnet-4.6,claude-opus-4-6=anthropic/claude-opus-4.6
# Speech out then uses the Mac's built-in voice unless ELEVENLABS_API_KEY or a real OpenAI key is set;
# `openclicky talk` (Realtime) needs a real OpenAI key.

# ---------------------------------------------------------------------------
# Session tokens (backend)
# ---------------------------------------------------------------------------
# [backend] Secret used to sign short-lived session tokens returned by POST /agent/session-token.
# Generate with: openssl rand -hex 32
SESSION_TOKEN_SECRET=
# [backend] Session token lifetime in seconds (default 3600).
SESSION_TOKEN_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Agent (agent/ CLI)
# ---------------------------------------------------------------------------
# [agent] Where the backend lives (default http://localhost:8787). Also accepted as --backend-url.
BACKEND_URL=http://localhost:8787   # default: https://api.openclicky.flowsxr.com (the hosted, invite-only backend)
# [agent] Supabase JWT or exchanged session token (also --token). Local dev: `npm run mint-jwt -w backend`.
OPENCLICKY_TOKEN=
# [agent] Isolated CODEX_HOME for OpenClicky's Codex runs (default ~/.openclicky/codex-home).
# Stable across runs so `--thread <id>` can resume; separate from your personal ~/.codex.
OPENCLICKY_CODEX_HOME=
# [agent] Working directory the agent operates in (default: current directory). Also --cwd.
OPENCLICKY_WORKSPACE=
# [agent] Optional model override for Codex runs (e.g. gpt-5.6-luna). Also --model.
OPENCLICKY_MODEL=
# [agent] Path to the codex binary (default: `codex` on PATH; install with `npm i -g @openai/codex`).
OPENCLICKY_CODEX_BIN=
# [agent] ffmpeg binary for `openclicky voice` microphone capture (default: `ffmpeg` on PATH; brew install ffmpeg).
OPENCLICKY_FFMPEG_BIN=
# [agent] The user's skill library root (library/, active/, activations.json); default ~/.openclicky/skills.
OPENCLICKY_USER_SKILLS_DIR=
# [agent] Composio MCP server URL. When set, the `composio` MCP server is added to the Codex config
# (bearer token = the OpenClicky session token; put Composio's own key behind your backend/proxy).
COMPOSIO_MCP_URL=
# [agent] Path to cua-driver. When set, the `computer-use` MCP server is added to the Codex config.
CUA_DRIVER_BIN=

# ---------------------------------------------------------------------------
# Accounts, credits, and hosting (all optional — a backend without these has no accounts and meters nothing)
# ---------------------------------------------------------------------------
# [backend] Service key (server-side, bypasses RLS): turns on the billing store (oc_* tables, see backend/supabase/schema.sql).
SUPABASE_SERVICE_KEY=
# [backend] Client-side key published by GET /auth/config so the app and CLI can sign in with only the backend URL.
SUPABASE_PUBLISHABLE_KEY=
# [backend] Monthly credits for signed-in users without an allowance (default 200). 0 = invite-only.
FREE_MONTHLY_CREDITS=
# [backend] Bring your own key: where a request's own keys are sent (defaults: the vendors' APIs). Tests override these.
BYOK_OPENAI_BASE_URL=
BYOK_ANTHROPIC_BASE_URL=
BYOK_ANTHROPIC_MODEL=
# [backend] Stripe (dormant unless set): /billing/checkout, /billing/portal, /billing/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=
# [agent, app] Bring your own key: sent per request as x-openclicky-openai-key / x-openclicky-anthropic-key.
# In the app these are `openaiApiKey` / `anthropicApiKey` in ~/.openclicky/shell.json.
OPENCLICKY_OPENAI_KEY=
OPENCLICKY_ANTHROPIC_KEY=
