<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>OpenClicky</AssemblyName>
    <RootNamespace>OpenClicky.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <StartupObject>OpenClicky.Windows.Program</StartupObject>
    <ApplicationIcon>Assets/OpenClicky.ico</ApplicationIcon>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is referenced only for NotifyIcon; keep its names out of the global usings so WPF types stay unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenClicky.Core\OpenClicky.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- RecordedVoice: the fixed lines recorded in the answering voice (copied from the Mac bundle). -->
    <Content Include="Assets\RecordedVoice\*.mp3" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\OpenClicky.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>

</Project>
