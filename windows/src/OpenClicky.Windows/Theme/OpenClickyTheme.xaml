<!--
    OpenClickyTheme.xaml — the design tokens of DesignSystem.swift (DS.Colors, DS.HUD) for XAML.
    The same values are in Theme/DS.cs for code-built views; keep both in step.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- DS.Colors -->
    <Color x:Key="OpenClicky.AccentColor">#FF2563EB</Color>
    <Color x:Key="OpenClicky.WarningColor">#FFFFB224</Color>
    <Color x:Key="OpenClicky.OverlayCursorColor">#FFF0452B</Color>
    <SolidColorBrush x:Key="OpenClicky.AccentBrush" Color="{StaticResource OpenClicky.AccentColor}" />
    <SolidColorBrush x:Key="OpenClicky.WarningBrush" Color="{StaticResource OpenClicky.WarningColor}" />
    <SolidColorBrush x:Key="OpenClicky.OverlayCursorBrush" Color="{StaticResource OpenClicky.OverlayCursorColor}" />

    <!-- DS.HUD (the island, always dark) -->
    <Color x:Key="OpenClicky.HUD.IslandColor">#FF000000</Color>
    <Color x:Key="OpenClicky.HUD.BandControlColor">#FF1A1A1A</Color>
    <Color x:Key="OpenClicky.HUD.SurfaceRaisedColor">#FF262626</Color>
    <Color x:Key="OpenClicky.HUD.SurfaceRaisedSoftColor">#FF2A2A2A</Color>
    <Color x:Key="OpenClicky.HUD.TextColor">#FFFFFFFF</Color>
    <Color x:Key="OpenClicky.HUD.Text2Color">#FFA3A3A3</Color>
    <Color x:Key="OpenClicky.HUD.Text3Color">#FF8A8A8A</Color>
    <Color x:Key="OpenClicky.HUD.PointerColor">#FFFF5A3C</Color>
    <Color x:Key="OpenClicky.HUD.PointerTintColor">#FF2A1A14</Color>
    <Color x:Key="OpenClicky.HUD.LiveColor">#FF34C77B</Color>
    <SolidColorBrush x:Key="OpenClicky.HUD.IslandBrush" Color="{StaticResource OpenClicky.HUD.IslandColor}" />
    <SolidColorBrush x:Key="OpenClicky.HUD.BandControlBrush" Color="{StaticResource OpenClicky.HUD.BandControlColor}" />
    <SolidColorBrush x:Key="OpenClicky.HUD.SurfaceRaisedBrush" Color="{StaticResource OpenClicky.HUD.SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="OpenClicky.HUD.SurfaceRaisedSoftBrush" Color="{StaticResource OpenClicky.HUD.SurfaceRaisedSoftColor}" />
    <SolidColorBrush x:Key="OpenClicky.HUD.TextBrush" Color="{StaticResource OpenClicky.HUD.TextColor}" />
    <SolidColorBrush x:Key="OpenClicky.HUD.Text2Brush" Color="{StaticResource OpenClicky.HUD.Text2Color}" />
    <SolidColorBrush x:Key="OpenClicky.HUD.Text3Brush" Color="{StaticResource OpenClicky.HUD.Text3Color}" />
    <SolidColorBrush x:Key="OpenClicky.HUD.PointerBrush" Color="{StaticResource OpenClicky.HUD.PointerColor}" />
    <SolidColorBrush x:Key="OpenClicky.HUD.PointerTintBrush" Color="{StaticResource OpenClicky.HUD.PointerTintColor}" />
    <SolidColorBrush x:Key="OpenClicky.HUD.LiveBrush" Color="{StaticResource OpenClicky.HUD.LiveColor}" />

    <system:Double x:Key="OpenClicky.HUD.PillHeight">24</system:Double>
    <system:Double x:Key="OpenClicky.HUD.TileSize">40</system:Double>
    <system:Double x:Key="OpenClicky.HUD.MinimumHitSize">22</system:Double>
    <system:Double x:Key="OpenClicky.HUD.TileRadius">10</system:Double>
    <system:Double x:Key="OpenClicky.HUD.IslandRadius">22</system:Double>
    <system:Double x:Key="OpenClicky.HUD.BodySidePadding">16</system:Double>
    <system:Double x:Key="OpenClicky.HUD.StripWidth">380</system:Double>
    <system:Double x:Key="OpenClicky.HUD.StripHeight">37</system:Double>

    <!-- Fonts: SF Pro → Segoe UI Variable, SF Mono → Cascadia Mono, SF Symbols → Segoe Fluent Icons -->
    <FontFamily x:Key="OpenClicky.UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="OpenClicky.DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="OpenClicky.MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="OpenClicky.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- The mark (OpenClickyMark.swift): a ring with a square top-right corner and the pointer, even-odd, unit square y down. -->
    <PathGeometry x:Key="OpenClicky.MarkGeometry" FillRule="EvenOdd"
                  Figures="M 1,0.5 A 0.5,0.5 0 1 1 0.5,0 L 1,0 Z M 0.9125,0.5 A 0.4125,0.4125 0 1 0 0.0875,0.5 A 0.4125,0.4125 0 1 0 0.9125,0.5 Z M 0.3125,0.3125 L 0.7475,0.475 L 0.505,0.52 L 0.4775,0.7525 Z" />
</ResourceDictionary>
