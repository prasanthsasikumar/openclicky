# Signing and notarization for scripts/release.sh. Copy to scripts/release.env (git-ignored);
# the script sources it before reading its OPENCLICKY_* variables.
#
# Distribution builds: the Developer ID certificate + a notarytool keychain profile, created once with
#   xcrun notarytool store-credentials openclicky --key ~/.openclicky/AuthKey_XXXX.p8 --key-id XXXX --issuer <issuer-uuid>
# (or --apple-id <email> --team-id <team> --password <app-specific-password>).
OPENCLICKY_SIGN_IDENTITY="Developer ID Application: FLOWXR PTE. LTD. (3U4384584Z)"
OPENCLICKY_TEAM_ID=3U4384584Z
OPENCLICKY_NOTARY_PROFILE=openclicky
